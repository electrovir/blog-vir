{
    "name": "blog-vir",
    "version": "0.0.6",
    "description": "Generate a blog.",
    "keywords": [
        "blog",
        "vir"
    ],
    "homepage": "https://github.com/electrovir/blog-vir",
    "bugs": {
        "url": "https://github.com/electrovir/blog-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/blog-vir.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "bin": "dist/cli/blog-vir.script.js",
    "scripts": {
        "build": "virmator frontend build",
        "compile": "virmator compile && chmod +x dist/cli/blog-vir.script.js",
        "docs": "virmator docs",
        "start": "npm run compile && virmator frontend",
        "test": "runstorm --names node,web \"npm run test:node\" \"npm run test:web\"",
        "test:docs": "virmator docs check",
        "test:node": "virmator test node 'src/**/*.test.node.ts'",
        "test:update": "runstorm --names node,web \"npm run test:node -- update\" \"npm run test:web -- update\"",
        "test:web": "virmator test web"
    },
    "dependencies": {
        "@augment-vir/assert": "^32.2.2",
        "@augment-vir/common": "^32.2.2",
        "@augment-vir/node": "^32.2.2",
        "@electrovir/color": "^1.7.11",
        "cli-vir": "^1.0.5",
        "config-vir": "^1.0.1",
        "date-vir": "^9.0.0",
        "element-vir": "*",
        "marked": "^18.0.9",
        "object-shape-tester": "^6.14.1",
        "spa-router-vir": "^6.6.1",
        "theme-vir": "^28.25.1",
        "url-vir": "^2.2.1",
        "vira": "^31.30.0"
    },
    "devDependencies": {
        "@augment-vir/test": "^32.2.2",
        "@types/node": "^26.2.0",
        "@web/dev-server-esbuild": "^2.0.0",
        "@web/test-runner": "^1.0.0",
        "@web/test-runner-playwright": "^1.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.6",
        "typedoc": "^0.28.20"
    },
    "peerDependencies": {
        "vite": "^8.2.1"
    },
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    }
}
